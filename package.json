{
  "name": "temporal-workdays",
  "version": "0.4.1",
  "description": "Add business days and business hours with the Temporal API: workdays, working hours, SLA deadlines, holidays (observed, Easter, nth weekday), overnight shifts, exact across DST. A moment-business-days / luxon-business-days alternative with zero dependencies.",
  "keywords": [
    "business-days",
    "business-hours",
    "add-business-days",
    "workdays",
    "working-days",
    "working-hours",
    "business-days-calculator",
    "sla",
    "sla-deadline",
    "holidays",
    "observed-holidays",
    "holiday-rules",
    "easter",
    "temporal",
    "temporal-api",
    "plaindate",
    "zoneddatetime",
    "dst",
    "overnight-shift",
    "weekend",
    "moment-business-days",
    "luxon-business-days",
    "date-fns",
    "date-holidays",
    "typescript"
  ],
  "license": "MIT",
  "author": "Akash Gupta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashgupta1909/temporal-workdays.git"
  },
  "homepage": "https://github.com/akashgupta1909/temporal-workdays#readme",
  "bugs": {
    "url": "https://github.com/akashgupta1909/temporal-workdays/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:smoke": "node test/smoke/smoke.mjs && node test/smoke/smoke-cjs.cjs",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "lint:pkg": "publint && attw --pack .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:consumer && npm run lint:pkg && npm run size && npm run test:smoke",
    "prepublishOnly": "npm run check",
    "test:consumer": "tsc -p test/consumer",
    "test:deno": "npx deno run --allow-read test/runtimes/run-local.mjs",
    "test:bun": "bun test/runtimes/run-local.mjs",
    "test:browsers": "node test/runtimes/browsers.mjs",
    "test:workers": "node test/runtimes/workers.mjs",
    "test:runtimes": "npm run test:deno && npm run test:bun && npm run test:browsers && npm run test:workers",
    "test:mutation": "stryker run",
    "bench": "npm run build && node bench/compare.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/luxon": "^3.7.6",
    "@types/luxon-business-days": "^3.0.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "date-fns": "^4.4.0",
    "date-holidays": "^3.38.1",
    "deno": "^2.9.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "luxon": "^3.7.2",
    "luxon-business-days": "^3.0.1",
    "miniflare": "^4.20260730.0",
    "moment": "^2.31.0",
    "moment-business-days": "^1.2.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "temporal-polyfill": "^1.0.8",
    "tinybench": "^6.2.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
