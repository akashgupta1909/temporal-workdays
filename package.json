{
  "name": "temporal-workdays",
  "version": "0.3.0",
  "description": "Business days and business hours for the JavaScript Temporal API: add workdays, add working time (SLA), count both, with weekends, holidays, breaks, half days and date-holidays support. Exact across DST. Zero dependencies.",
  "keywords": [
    "business-days",
    "business-days-alternative",
    "business-hours",
    "calendar",
    "date",
    "date-holidays",
    "dst",
    "holidays",
    "moment-business-days",
    "plaindate",
    "sla",
    "temporal",
    "weekend",
    "workdays",
    "working-days",
    "working-hours",
    "zoneddatetime"
  ],
  "license": "MIT",
  "author": "Akash Gupta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akashgupta1909/temporal-workdays.git"
  },
  "homepage": "https://github.com/akashgupta1909/temporal-workdays#readme",
  "bugs": {
    "url": "https://github.com/akashgupta1909/temporal-workdays/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:smoke": "node test/smoke/smoke.mjs",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "lint:pkg": "publint && attw --pack .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:consumer && npm run lint:pkg && npm run size && npm run test:smoke",
    "prepublishOnly": "npm run check",
    "test:consumer": "tsc -p test/consumer"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "date-holidays": "^3.38.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "moment": "^2.31.0",
    "moment-business-days": "^1.2.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "temporal-polyfill": "^1.0.8",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
